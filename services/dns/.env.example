# FQDN this DNS server identifies itself as. Only read on first boot
# (ignored once /etc/dns already has config).
DNS_SERVER_DOMAIN=dns.home.jaewook.me

# Sets the INITIAL web console admin password only; changeable later
# via the web UI. Use a strong, unique value.
DNS_SERVER_ADMIN_PASSWORD=

# SSO login via authentik (OAuth2/OpenID Connect provider + application
# created in authentik first — see docs/README for the authentik-side
# steps). Only applied on first boot, same as the vars above. Many more
# optional first-boot env vars exist beyond these (recursion ACLs,
# forwarders, blocklist URLs); see Technitium's DockerEnvironmentVariables.md.
DNS_SERVER_SSO_ENABLED=true
DNS_SERVER_SSO_AUTHORITY=https://auth.home.jaewook.me/application/o/REPLACE_WITH_APPLICATION_SLUG/
DNS_SERVER_SSO_CLIENT_ID=
DNS_SERVER_SSO_CLIENT_SECRET=
DNS_SERVER_SSO_SCOPES=openid profile
DNS_SERVER_SSO_ALLOW_SIGNUP=true
DNS_SERVER_SSO_GROUP_MAP=Technitium Admins:Administrators
