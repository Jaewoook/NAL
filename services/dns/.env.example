# FQDN this DNS server identifies itself as. Only read on first boot
# (ignored once /etc/dns already has config).
DNS_SERVER_DOMAIN=dns.home.jaewook.me

# Sets the INITIAL web console admin password only; changeable later
# via the web UI. Use a strong, unique value.
DNS_SERVER_ADMIN_PASSWORD=

# Many more optional first-boot env vars exist (recursion ACLs, forwarders,
# blocklist URLs, DNS_SERVER_SSO_* for OIDC). See Technitium's
# DockerEnvironmentVariables.md if/when those are needed.
