# Atlas inference host LAN IP
ATLAS_HOST=182.168.0.100

# LiteLLM Keys
LITELLM_MASTER_KEY=sk-master-change-me
LITELLM_SALT_KEY=salt-change-me

# Database Credentials (connected to services/db on db_network)
LITELLM_DB_USER=litellm
LITELLM_DB_PASS=litellm_pass
LITELLM_DB_NAME=litellm

# Authentik OIDC SSO Configuration
LITELLM_OIDC_CLIENT_ID=
LITELLM_OIDC_CLIENT_SECRET=
LITELLM_OIDC_DISCOVERY_URL=https://auth.jaewook.dev/application/o/litellm/.well-known/openid-configuration
LITELLM_OIDC_REDIRECT_URI=https://litellm.jaewook.dev/sso/callback
