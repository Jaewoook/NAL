# You should change it false before to change the config
# ENABLE_PERSISTENT_CONFIG=false

OLLAMA_BASE_URL=http://host.docker.internal:11434

# Auth
ENABLE_OAUTH_ID_TOKEN_COOKIE=false

# SSO Configuration
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OPENID_PROVIDER_URL=
OPENID_REDIRECT_URI=https://llm.jaewook.dev/oauth/oidc/callback
OAUTH_SCOPES=openid email profile roles
OAUTH_USERNAME_CLAIM=preferred_username
OAUTH_ROLES_CLAIM=roles
OAUTH_ALLOWED_ROLES=user,admin
OAUTH_ADMIN_ROLES=admin
OAUTH_AUTO_REDIRECT=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
ENABLE_LOGIN_FORM=false
ENABLE_PASSWORD_AUTH=false
ENABLE_OAUTH=true
ENABLE_OAUTH_SIGNUP=true
ENABLE_OAUTH_ROLE_MANAGEMENT=true

WEBUI_URL=https://llm.jaewook.dev
WEBUI_SECRET_KEY=