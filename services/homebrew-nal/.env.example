# Server Configuration
PORT=10245

# GitHub Actions Dispatch & Repository Access
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_REPO_OWNER=jaewoook
GITHUB_REPO_NAME=homebrew-nal
GITHUB_SYNC_WORKFLOW=sync-upstream.yml
GITHUB_BUILD_WORKFLOW=build.yml

# Authentik OIDC Integration
AUTHENTIK_ISSUER=https://auth.jaewook.dev/application/o/homebrew-nal/
AUTHENTIK_CLIENT_ID=homebrew-nal-web
AUTHENTIK_CLIENT_SECRET=your_authentik_client_secret

# NextAuth / Session Secret
NEXTAUTH_SECRET=generate_with_openssl_rand_hex_32
NEXTAUTH_URL=https://homebrew-nal.jaewook.dev

# Database Configuration (Kysely ORM - Supports SQLite, PostgreSQL, MySQL, MariaDB)
# Option 1: SQLite (Default out-of-the-box standalone)
# DB_TYPE=sqlite
DATABASE_PATH=data/app.db

# Option 2: Generic Connection URL (Supports postgres://, mysql://, mariadb://, sqlite://)
# DATABASE_URL=postgresql://homebrew_nal:your_password@localhost:5432/homebrew_nal
# DATABASE_URL=mysql://root:your_password@localhost:3306/homebrew_nal

# Option 3: Individual Environment Variables for PostgreSQL
# PG_HOST=localhost
# PG_PORT=5432
# PG_DB=homebrew_nal
# PG_USER=homebrew_nal
# PG_PASS=your_postgres_password_here

# Option 4: Individual Environment Variables for MySQL / MariaDB
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=homebrew_nal
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password_here

CACHE_TTL_SECONDS=600
