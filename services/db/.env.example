# Superuser for the shared postgres instance. Only used for provisioning
# (init scripts run as this user); application services get their own
# database/role via services/db/init/*.sh instead of using this account.
PG_DB=postgres
PG_USER=postgres
PG_PASS=

# --- per-service credentials consumed by services/db/init/*.sh ---
# Add one block per service that needs a database here, then add a matching
# numbered script under ./init/ (see init/10-authentik.sh for the pattern).

AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASS=

HOMEBREW_NAL_DB_NAME=homebrew_nal
HOMEBREW_NAL_DB_USER=homebrew_nal
HOMEBREW_NAL_DB_PASS=

GUACAMOLE_DB_NAME=guacamole_db
GUACAMOLE_DB_USER=guacamole
GUACAMOLE_DB_PASS=

LITELLM_DB_NAME=litellm
LITELLM_DB_USER=litellm
LITELLM_DB_PASS=

SYSTEM_UPDATER_DB_NAME=system_updater
SYSTEM_UPDATER_DB_USER=system_updater
SYSTEM_UPDATER_DB_PASS=
