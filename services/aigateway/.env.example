# Atlas inference host LAN IP
ATLAS_HOST=192.168.0.100

# AI Gateway (LiteLLM) Keys
LITELLM_MASTER_KEY=sk-master-change-me
LITELLM_SALT_KEY=salt-change-me

# Database Credentials (connected to services/db on db_network)
LITELLM_DB_USER=litellm
LITELLM_DB_PASS=litellm_pass
LITELLM_DB_NAME=litellm

# Authentik Generic OIDC SSO Configuration
GENERIC_CLIENT_ID=ai-gateway
GENERIC_CLIENT_SECRET=
GENERIC_AUTHORIZATION_ENDPOINT=https://auth.jaewook.dev/application/o/authorize/
GENERIC_TOKEN_ENDPOINT=https://auth.jaewook.dev/application/o/token/
GENERIC_USERINFO_ENDPOINT=https://auth.jaewook.dev/application/o/userinfo/
GENERIC_SCOPE="openid email profile"

# Role mappings for Authentik SSO groups
GENERIC_ROLE_MAPPINGS_GROUP_CLAIM=groups
GENERIC_ROLE_MAPPINGS_ROLES="{'proxy_admin': ['service-admins', 'nal-system-admins', 'authentik Admins'], 'internal_user': ['service-customers', 'nal-system-users']}"
GENERIC_ROLE_MAPPINGS_DEFAULT_ROLE="internal_user"

PROXY_BASE_URL=https://aigateway.jaewook.dev
