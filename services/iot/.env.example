# Timezone for Home Assistant (e.g. Asia/Seoul).
TZ=

# URL Matter Hub uses to reach Home Assistant. Matter Hub runs with host
# networking, so it cannot resolve the `homeassistant` container by name:
# use the reverse-proxied URL.
HAMH_HOME_ASSISTANT_URL=https://ha.home.jaewook.me

# Long-lived access token created in Home Assistant (profile page ->
# Security -> Long-Lived Access Tokens). Only exists after Home Assistant's
# first-run setup.
HAMH_HOME_ASSISTANT_ACCESS_TOKEN=

# matter-hub is opt-in so `manage-services.sh start` only brings up Home
# Assistant at first. Uncomment once the token above is set and the
# validation steps in README.md reach matter-hub.
# COMPOSE_PROFILES=matter
