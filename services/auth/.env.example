# Must match the AUTHENTIK_DB_* values provisioned in services/db/.env
# (see services/db/init/10-authentik.sh).
PG_DB=authentik
PG_USER=authentik
PG_PASS=

# Generate with: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=

# Optional: pin a specific authentik image/tag.
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
# AUTHENTIK_TAG=2026.5.3

# Optional: email service configs
AUTHENTIK_EMAIL__HOST=
AUTHENTIK_EMAIL__PORT=
AUTHENTIK_EMAIL__USERNAME=
AUTHENTIK_EMAIL__PASSWORD=
AUTHENTIK_EMAIL__USE_TLS=
AUTHENTIK_EMAIL__USE_SSL=
AUTHENTIK_EMAIL__FROM=
