# ==============================================================================
# Server Monitor Environment Variables Example
# ==============================================================================
# The monitor can run purely with environment variables without config.yaml.
# Setting a channel's token/webhook URL automatically enables that channel.

# Server Identity
SERVER_NAME="my-physical-server"
CHECK_INTERVAL_SECONDS=5

# --- Telegram (Reuses for_jaewook_bot settings directly) ---
BOT_TOKEN=
DEFAULT_CHAT_ID=
# Aliases also supported:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Discord ---
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# --- Slack ---
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."

# --- Generic Webhook ---
# WEBHOOK_URL="https://example.com/api/alerts"

# --- Outbound Dead-Man's Switch (Healthchecks.io / BetterStack) ---
# HEARTBEAT_URL="https://hc-ping.com/YOUR-UUID"
# HEARTBEAT_INTERVAL_SECONDS=60

# --- Alerting Thresholds ---
# CPU_SPIKE_THRESHOLD=85.0
# CPU_SPIKE_SUSTAINED_SECONDS=15
# CPU_SPIKE_COOLDOWN_MINUTES=30
# MEMORY_THRESHOLD=90.0
# DISK_THRESHOLD=85.0
# NOTIFY_ON_RECOVERY=true
