# SSH & initial account settings for Aegis (Raspberry Pi 3B+)
AEGIS_HOST=aegis.local
AEGIS_USER=pi
AEGIS_SSH_PORT=22
# Optional private key path (leave blank to use default SSH agent / keys)
AEGIS_SSH_KEY=

# Post-flash SD card preparation options (Step 0: sd)
# Plaintext password hashed to SHA-512 ($6$) for userconf.txt (leave blank to prompt).
# Or set AEGIS_PASSWORD_HASH directly to a pre-hashed $6$... string instead
# (.env values are parsed literally without shell variable expansion).
AEGIS_PASSWORD=
AEGIS_PASSWORD_HASH=
# Mounted SD card boot partition on macOS (blank = auto-detect /Volumes/bootfs or /Volumes/boot)
AEGIS_BOOT_DIR=

# Host preparation options (Step 1: prep)
AEGIS_NODE_NAME=aegis
# System locale to generate and set as default on Aegis (leave blank to keep OS default)
AEGIS_LOCALE=en_US.UTF-8
AEGIS_GPU_MEM=16
AEGIS_ZRAM_PERCENT=50
# Compression algorithm for legacy zram-tools fallback (lz4, zstd, lzo, or lzo-rle)
AEGIS_ZRAM_ALGO=lz4
# Aegis uses wired Ethernet, so disabling wireless radios frees RAM and power
AEGIS_DISABLE_WIFI=true
AEGIS_DISABLE_BLUETOOTH=true
# Frees port 53 so Technitium DNS can bind on Aegis later
AEGIS_DISABLE_RESOLVED_STUB=true

# Kubernetes cluster join settings (Step 2: join)
# Populate these once Axis's k3s control plane is running.
K3S_URL=
K3S_TOKEN=
# Optional k3s version matching Axis's control plane (e.g. v1.31.4+k3s1); blank = latest.
# Pinning avoids Kubernetes skew issues (agent minor version must be <= server).
K3S_VERSION=
