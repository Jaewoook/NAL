# Lima VM & Kubernetes node settings for Axis (Mac Mini M2, 16 GB, macOS)
AXIS_VM_NAME=axis-k3s
AXIS_NODE_NAME=axis

# VM resource allocation (keep conservative on 16 GB host while Docker stacks are migrating)
AXIS_CPUS=4
AXIS_MEMORY=6GiB
AXIS_DISK=64GiB

# Bridged networking onto wired Ethernet (`en0` recommended; macOS Wi-Fi blocks L2 bridging)
AXIS_BRIDGE_IFACE=en0
# Optional custom MAC for router static DHCP reservation (blank = deterministic from AXIS_VM_NAME)
AXIS_BRIDGE_MAC=
# Expected bridged LAN IP on `lima0` once reserved on router (blank = accept DHCP lease dynamically)
AXIS_NODE_IP=

# One-time macOS host bootstrap (`bootstrap` command)
AXIS_SOCKET_VMNET_VERSION=v1.2.2
# Autostart via launchd: login (LaunchAgent), boot (LaunchDaemon via sudo), or none
AXIS_AUTOSTART_MODE=login

# k3s control plane configuration
# Optional version pin to keep in sync with nodes/aegis/.env (e.g. v1.31.6+k3s1); blank = latest
AXIS_K3S_VERSION=
# Disable bundled addons if replacing with custom Ingress / LoadBalancer controllers
AXIS_K3S_DISABLE_TRAEFIK=false
AXIS_K3S_DISABLE_SERVICELB=false

# Local macOS kubeconfig settings (`kubeconfig` / `up` commands)
AXIS_KUBECONFIG_PATH=~/.kube/config
AXIS_KUBECONFIG_CONTEXT=nal
AXIS_LOCAL_API_PORT=6443
